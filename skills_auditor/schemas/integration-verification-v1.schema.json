{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ERerGB/skills-auditor/blob/main/skills_auditor/schemas/integration-verification-v1.schema.json",
  "title": "Skills Auditor Integration Verification v1",
  "type": "object",
  "required": ["schema_version", "checked_at", "receipt_id", "plan_id", "status", "checks", "summary"],
  "properties": {
    "schema_version": {"const": "skills-auditor-verification/v1"},
    "checked_at": {"type": "string", "format": "date-time"},
    "receipt_id": {"type": "string", "pattern": "^receipt-[0-9a-f]{20}$"},
    "plan_id": {"type": "string", "pattern": "^plan-[0-9a-f]{20}$"},
    "status": {"enum": ["passed", "failed"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "ok"],
        "properties": {
          "code": {"enum": ["receipt_not_completed", "target_link", "source_tree"]},
          "ok": {"type": "boolean"}
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["state", "requires_reapproval", "reason_codes"],
      "properties": {
        "state": {"enum": ["valid", "invalidated"]},
        "requires_reapproval": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "items": {"enum": ["receipt_not_completed", "target_link", "source_tree"]},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "valid"}}},
          "then": {
            "properties": {
              "requires_reapproval": {"const": false},
              "reason_codes": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "requires_reapproval": {"const": true},
              "reason_codes": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["checks", "passed", "failed"],
      "properties": {
        "checks": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"required": ["approval"]},
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "checks": {
                  "contains": {
                    "type": "object",
                    "required": ["ok"],
                    "properties": {"ok": {"const": false}}
                  }
                }
              }
            },
            "then": {
              "properties": {
                "status": {"const": "failed"},
                "approval": {
                  "properties": {
                    "state": {"const": "invalidated"},
                    "requires_reapproval": {"const": true}
                  }
                }
              }
            },
            "else": {
              "properties": {
                "status": {"const": "passed"},
                "approval": {
                  "properties": {
                    "state": {"const": "valid"},
                    "requires_reapproval": {"const": false},
                    "reason_codes": {"maxItems": 0}
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "checks": {
                  "contains": {
                    "type": "object",
                    "required": ["code", "ok"],
                    "properties": {
                      "code": {"const": "receipt_not_completed"},
                      "ok": {"const": false}
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "approval": {
                  "properties": {
                    "reason_codes": {"contains": {"const": "receipt_not_completed"}}
                  }
                }
              }
            },
            "else": {
              "properties": {
                "approval": {
                  "properties": {
                    "reason_codes": {"not": {"contains": {"const": "receipt_not_completed"}}}
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "checks": {
                  "contains": {
                    "type": "object",
                    "required": ["code", "ok"],
                    "properties": {
                      "code": {"const": "target_link"},
                      "ok": {"const": false}
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "approval": {
                  "properties": {
                    "reason_codes": {"contains": {"const": "target_link"}}
                  }
                }
              }
            },
            "else": {
              "properties": {
                "approval": {
                  "properties": {
                    "reason_codes": {"not": {"contains": {"const": "target_link"}}}
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "checks": {
                  "contains": {
                    "type": "object",
                    "required": ["code", "ok"],
                    "properties": {
                      "code": {"const": "source_tree"},
                      "ok": {"const": false}
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "approval": {
                  "properties": {
                    "reason_codes": {"contains": {"const": "source_tree"}}
                  }
                }
              }
            },
            "else": {
              "properties": {
                "approval": {
                  "properties": {
                    "reason_codes": {"not": {"contains": {"const": "source_tree"}}}
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
